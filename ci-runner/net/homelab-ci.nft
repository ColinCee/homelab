#!/usr/sbin/nft -f
# Network for the CI microVMs. Each slot has its own tap (fc-tapN, 10.200.N.0/30).
# VMs reach the internet through NAT; everything private is dropped: the LAN, the
# tailnet, Docker networks, Beelink itself and the other slots. Nothing outside may
# open a connection to a VM. A drop here is final whatever other tables accept.
#
# Traffic still needs an accept in iptables' FORWARD chain, whose policy is DROP
# (Docker and UFW); setup-net.sh adds a narrow one in DOCKER-USER.
#
# The second table, homelab_wall, walls off Docker's bridge containers the same way
# (docs/adr/0005-container-network-wall.md). It lives here because this file is what
# the host reloads on every merge; it is not CI's.

define private4 = {
  0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
  172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15,
  224.0.0.0/4, 240.0.0.0/4
}

table inet homelab_ci
delete table inet homelab_ci

table inet homelab_ci {
  set private4 {
    type ipv4_addr
    flags interval
    elements = $private4
  }

  # The home's public address. The router answers on it from inside (its admin
  # pages, and any port forwards), so it is as private as the LAN. It changes,
  # so it is refreshed before every VM starts (setup-net.sh wan).
  set wan4 {
    type ipv4_addr
  }

  chain input {
    type filter hook input priority filter; policy accept;
    # A VM may not talk to Beelink at all. MMDS is answered by Firecracker
    # itself and never reaches the host.
    iifname "fc-tap*" counter drop
  }

  chain forward {
    type filter hook forward priority filter; policy accept;
    iifname "fc-tap*" meta nfproto ipv6 counter drop
    # A VM may only use its own address: no posing as another slot or
    # sending unNATed traffic with someone else's address. (rp_filter is loose
    # on Beelink, so this rule is what enforces it.)
    iifname "fc-tap*" fib saddr . iif oif missing counter drop
    iifname "fc-tap*" ip daddr @private4 counter drop
    iifname "fc-tap*" ip daddr @wan4 counter drop
    # Into a VM: replies only.
    oifname "fc-tap*" ct state established,related accept
    oifname "fc-tap*" counter drop
  }

  # The slot users Firecracker runs as (setup-net.sh fills it). Firecracker needs no
  # sockets of its own (its tap carries the VM's traffic), so one that escaped its VM
  # may not open any connection from Beelink: loopback, LAN, tailnet or internet.
  set slot_uids {
    type uid
  }

  chain output {
    type filter hook output priority filter; policy accept;
    meta skuid @slot_uids counter drop
    # Beelink's own processes (tailscaled, host-network containers) may not
    # open connections to a VM either.
    oifname "fc-tap*" ct state established,related accept
    oifname "fc-tap*" counter drop
  }

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr 10.200.0.0/16 oifname != "fc-tap*" masquerade
  }
}

# Docker's bridge containers (the public flight tracker among them) reach the internet
# and each other, nothing else of the home: not Beelink's own addresses (the ports
# published on the Tailscale address included), the LAN, the tailnet or the public
# address. And nothing arriving from the LAN may open a connection through Beelink.
# Host-network containers are Beelink itself and are not covered.
table inet homelab_wall
delete table inet homelab_wall

table inet homelab_wall {
  set private4 {
    type ipv4_addr
    flags interval
    elements = $private4
  }

  # As in homelab_ci; setup-net.sh fills both.
  set wan4 {
    type ipv4_addr
  }

  # Beelink's DNS servers (setup-net.sh fills it from systemd-resolved). Builds and
  # containers on Docker's default bridge ask them directly, not through Beelink.
  set resolvers {
    type ipv4_addr
  }

  # Before Docker's DNAT (priority dstnat), so this sees the address the container
  # asked for, not the container a published port leads to.
  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;
    iifname { "docker*", "br-*" } ct state != { established, related } jump from_container
  }

  chain from_container {
    fib daddr type local counter drop
    # Other containers. Bridged traffic passes here too (br_netfilter).
    fib daddr oifname { "docker*", "br-*" } return
    # The CI VMs, which homelab_ci drops and test-network.sh counts there.
    fib daddr oifname "fc-tap*" return
    ip daddr @resolvers meta l4proto { tcp, udp } th dport 53 return
    ip daddr @private4 counter drop
    ip daddr @wan4 counter drop
  }

  # New forwarded connections come only from containers, CI VMs and the tailnet
  # (its way in to the published ports). From the LAN, a static route to the
  # Tailscale address would otherwise reach those ports through Docker's DNAT.
  chain forward {
    type filter hook forward priority filter; policy accept;
    ct state != { established, related } iifname != { "docker*", "br-*", "fc-tap*", "tailscale0" } counter drop
  }
}
