#!/usr/bin/env bash
# Prints the CI runner's build machines as JSON, counts only (ci_supervisor.py, capacity()):
# it asks on the console and reads the answer off the inbox disk, as handoff.sh get does.
# Fails within WAIT seconds (default 15) when no supervisor answers, such as on a host
# without this ask.
set -euo pipefail

sudo=${SUDO-sudo}
direct=${CAPACITY_DIRECT-direct}
console=${CAPACITY_CONSOLE:-/dev/ttyS0}
wait=${CAPACITY_WAIT:-15}

head_of() {
  local cmd=(dd if="$1" bs=512 count=1 ${direct:+iflag=$direct} status=none)
  if [[ -r $1 ]]; then "${cmd[@]}"; else $sudo "${cmd[@]}"; fi | head -n 1 | tr -d '\0'
}

disk=""
for candidate in ${DISKS:-/dev/vd?}; do
  [[ -e $candidate && $(head_of "$candidate") == homelab-ci-inbox* ]] && { disk=$candidate; break; }
done
[[ -n $disk ]] || { echo "ci-capacity: no inbox disk in this VM" >&2; exit 1; }

nonce=$(head -c 12 /dev/urandom | od -An -tx1 | tr -d ' \n')
line="HOMELAB-CAPACITY 1 $nonce"
if [[ -w $console ]]; then echo "$line" > "$console"; else echo "$line" | $sudo tee "$console" > /dev/null; fi
deadline=$((SECONDS + wait))
until [[ $(head_of "$disk") =~ ^homelab-ci-inbox\ v1\ $nonce\ ([a-z]+)\ ([0-9]+)$ ]]; do
  ((SECONDS < deadline)) || { echo "ci-capacity: the CI supervisor did not answer in ${wait}s" >&2; exit 1; }
  sleep 0.5
done
[[ ${BASH_REMATCH[1]} == ok ]] || { echo "ci-capacity: the CI supervisor has no counts (${BASH_REMATCH[1]})" >&2; exit 1; }
bytes=${BASH_REMATCH[2]}
cmd=(dd if="$disk" bs=4096 iflag=skip_bytes${direct:+,$direct} skip=512 count=$(((bytes + 4095) / 4096 + 1)) status=none)
if [[ -r $disk ]]; then "${cmd[@]}"; else $sudo "${cmd[@]}"; fi | head -c "$bytes"
echo
