#!/bin/bash
# First and only task of a CI microVM. The host passes the network on the kernel
# command line (ci.ip=, ci.gw=) and the task through MMDS; when it exits, the VM ends.
# Whatever happens, the VM ends: it is never reused.
set -uo pipefail

arg() { tr ' ' '\n' < /proc/cmdline | sed -n "s/^$1=//p"; }

ip link set lo up
ip link set eth0 up
ip addr add "$(arg ci.ip)" dev eth0
ip route add default via "$(arg ci.gw)"
# MMDS answers on this address inside Firecracker; it never reaches the host.
ip route add 169.254.169.254/32 dev eth0

mmds() {
  local token
  token=$(curl -sf -X PUT -H 'X-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token) || return 1
  curl -sf -H "X-metadata-token: $token" -H 'Accept: application/json' "http://169.254.169.254/$1"
}

task=$(mmds task | jq -r . 2>/dev/null)
case "$task" in
  probe)
    mmds probe | jq -r . > /run/probe.sh
    echo "=== probe start"
    bash /run/probe.sh
    echo "=== probe end"
    ;;
  runner)
    # Package caches and main's installs: a read-only disk from the host (built
    # from main only), with a throwaway layer on top so the job can write but
    # nothing it writes outlives the VM. Without the disk, an empty /cache.
    mkdir -p /cache /run/cache-lower /run/cache-rw
    mount -t tmpfs -o mode=0755 tmpfs /run/cache-rw
    mkdir -p /run/cache-rw/upper /run/cache-rw/work
    if [[ -b /dev/vdb ]] && mount -o ro,noload /dev/vdb /run/cache-lower; then
      mount -t overlay overlay -o lowerdir=/run/cache-lower,upperdir=/run/cache-rw/upper,workdir=/run/cache-rw/work /cache
    else
      mount --bind /run/cache-rw/upper /cache
    fi
    chown runner:runner /cache
    printf 'UV_CACHE_DIR=/cache/uv\nnpm_config_cache=/cache/npm\nUV_PROJECT_ENVIRONMENT=/cache/venv\n' >> /opt/runner/.env
    # A just-in-time runner: registered for exactly one job, gone afterwards.
    jit=$(mmds jitconfig | jq -r .)
    echo "=== runner start"
    sudo -u runner -H /opt/runner/run.sh --jitconfig "$jit"
    echo "=== runner end (exit $?)"
    unset jit
    ;;
  *)
    echo "ci-boot: unknown task '${task}'"
    ;;
esac

# ci-boot.service reboots the VM when this exits, and Firecracker exits with it.
