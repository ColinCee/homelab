[Unit]
Description=Record CI and deploy run times as traces and metrics (scripts/ci_times.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/homelab-python3 -I /usr/local/lib/homelab-ci/ci_times.py
Nice=10
# Reads the CI token and GitHub, writes its state and one metrics file, and posts to Alloy.
ProtectSystem=strict
ReadWritePaths=/var/lib/homelab-metrics /var/lib/homelab-ci
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
MemoryMax=256M
# Under the timer's 5 minutes; a pass cut short keeps what it sent (ci_times.py, poll).
TimeoutStartSec=4min
