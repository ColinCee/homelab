[Unit]
Description=Drain the CI runner, run its load test at every slot and keep the result (ci_supervisor.py load-test)
After=homelab-ci-supervisor.service
# At most 3 runs in 6 hours (a FAIL at 5, then 4, then 3), whatever goes wrong, even a record that
# cannot be written: update.sh asks every minute, and each run drains the host.
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=oneshot
# The drain waits up to 65 minutes for running jobs, then the test takes a few.
TimeoutStartSec=90min
ExecStart=/usr/local/bin/homelab-python3 -I /usr/local/lib/homelab-ci/ci_supervisor.py load-test
# However it ends, a crash or a timeout included, the supervisor takes jobs again.
ExecStopPost=/usr/bin/rm -f /run/homelab-ci/load-test-drain
