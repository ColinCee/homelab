[Unit]
Description=Start a Firecracker VM for each queued CI job on the allowed private repos
After=homelab-ci-net.service network-online.target
Requires=homelab-ci-net.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/lib/homelab-ci/ci_supervisor.py
Restart=always
RestartSec=30
# Stopping or restarting the supervisor sends it alone SIGTERM: it starts no new VM and
# waits for running jobs to finish (up to 20 minutes, RESTART_WAIT_SECONDS), then exits.
# Whatever is left after that, and after a crash, is killed, VMs included.
KillMode=mixed
TimeoutStopSec=22min
ExecStopPost=/usr/local/lib/homelab-ci/stop-vms.sh
Nice=5

[Install]
WantedBy=multi-user.target
