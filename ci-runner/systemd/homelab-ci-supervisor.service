[Unit]
Description=Start a Firecracker VM for each queued CI job on the allowed private repos
After=homelab-ci-net.service network-online.target
Requires=homelab-ci-net.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/homelab-python3 -I /usr/local/lib/homelab-ci/ci_supervisor.py
Restart=always
RestartSec=30
# Each VM is a unit of its own (homelab-ci-vm-*), so stopping or restarting the supervisor
# leaves running VMs alone; it takes them back when it starts. stop-vms.sh stops them all.
Nice=5

[Install]
WantedBy=multi-user.target
