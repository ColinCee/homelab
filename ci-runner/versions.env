# Pinned versions for the Firecracker CI runner. Renovate opens a PR when a new
# release appears; the host only changes when install-host.sh is re-run by hand.

# renovate: datasource=github-releases depName=firecracker-microvm/firecracker
FIRECRACKER_VERSION=v1.17.0
FIRECRACKER_SHA256=06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558

# renovate: datasource=github-releases depName=actions/runner
RUNNER_VERSION=v2.338.2
RUNNER_SHA256=baebf204307bac6193480852732f0aba2ae97b6c5597c244f4d5558390147c40

# Tools baked into the VM image, so jobs do not download them each time.
# renovate: datasource=node-version depName=node
NODE_VERSION=24.22.2
NODE_SHA256=48cc0e21e048790e54c0cf5749c2725005313d652651c40b7a21feb9697aaf75
# renovate: datasource=github-releases depName=astral-sh/uv
UV_VERSION=0.13.6
UV_SHA256=f29c3e94ffabd7e6f3ba521dba169a9b7ec12100bf3257087f0f24f6123f3645
PYTHON_VERSION=3.15
# renovate: datasource=java-version depName=java-jdk
JDK_VERSION=25.0.5+8
JDK_SHA256=68982529869257d0ee6b824ec5aa270ff8b118bb438670da0b97ebdab178d7fb
# mise installs the tools a repo's mise.toml lists; docker is the CLI alone (no
# daemon), enough for `docker compose config`.
# renovate: datasource=github-releases depName=jdx/mise
MISE_VERSION=v2026.10.25
MISE_SHA256=5d362ecc578dc7c146679b841dda949d6472cbf86ff5635db7afdca1b6b3fd87
# renovate: datasource=npm depName=bun
BUN_VERSION=1.4.4
BUN_SHA256=bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c
# renovate: datasource=npm depName=pnpm
PNPM_VERSION=12.16.1
PNPM_SHA256=565ff81174a14f6f7bd5d84c1b17e51031a80230d370a1fe24be5d16bd02a825
# renovate: datasource=github-tags depName=docker/cli
DOCKER_VERSION=v29.9.2
DOCKER_SHA256=9ac225999fd5e863f7694c728ef23d480616b1e5639328fa309befd4243d69eb
# renovate: datasource=github-releases depName=docker/compose
COMPOSE_VERSION=v5.6.1
COMPOSE_SHA256=47737f4236e6d3ccea7291995203f8f018058783b4c3a9469119811a0b5db8c0

# Actions unpacked into the image, so the runner does not download them per job
# (ACTIONS_RUNNER_ACTION_ARCHIVE_CACHE). Exact commits of the tags the CI repos use
# (checkout and upload-artifact v7);
# a tag that has moved on is simply downloaded as before.
CACHED_ACTIONS="actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9"
