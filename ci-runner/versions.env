# Pinned versions for the Firecracker CI runner. Renovate opens a PR when a new
# release appears, and under `renovate-hash` (a GitHub release asset) moves the hash too.
# CI checks each changed hash against its download, built by checks/versions_hash.py
# from the same URLs as rootfs/Dockerfile and install_host.py: change a URL in both.

# renovate-hash: depName=firecracker-microvm/firecracker
FIRECRACKER_VERSION=v1.18.0
FIRECRACKER_SHA256=1ac8eec866dd5eea14efecf6323e22b23eea24054545338a5b34bc5bca6623cd

# The Python the host's units run (/usr/local/bin/homelab-python3): a python-build-standalone
# release, whose tag is a date. PBS_PYTHON is the version inside it and must equal mise.toml's python
# (tests/test_install_host.py): when a release carries a newer patch, move both together.
# renovate-hash: depName=astral-sh/python-build-standalone
PBS_VERSION=20261110
PBS_SHA256=ad23d1b73fac26440b0306ae06911031344c49a90ec19716c8362e7fa40cae43
PBS_PYTHON=3.15.2

# renovate-hash: depName=actions/runner
RUNNER_VERSION=v2.338.2
RUNNER_SHA256=baebf204307bac6193480852732f0aba2ae97b6c5597c244f4d5558390147c40

# Tools baked into the VM image, so jobs do not download them each time.
# renovate: datasource=node-version depName=node
NODE_VERSION=26.13.0
NODE_SHA256=d28a96af6c38596f6d9d97c0ee531c13d238d757742387d1928de822d959e997
# renovate-hash: depName=astral-sh/uv
UV_VERSION=0.13.7
UV_SHA256=c5221ff41b7892bfc223543883600125f6a47fe845093e0f5bdff4f359196d83
# renovate: datasource=python-version depName=python
PYTHON_VERSION=3.15
# renovate: datasource=java-version depName=java-jdk
JDK_VERSION=25.0.5+8
JDK_SHA256=68982529869257d0ee6b824ec5aa270ff8b118bb438670da0b97ebdab178d7fb
# mise installs the tools a repo's mise.toml lists; docker is the static bundle
# (CLI, engine, containerd, runc) with the compose and buildx plugins.
# renovate-hash: depName=jdx/mise
MISE_VERSION=v2026.11.6
MISE_SHA256=5fb74f80aab81e0a5ca20eb6414cc69b78ae0cab1deaeb521572ed26d8d4a6e3
# renovate: datasource=npm depName=bun
BUN_VERSION=1.4.4
BUN_SHA256=bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c
# renovate: datasource=npm depName=pnpm
PNPM_VERSION=12.18.0
PNPM_SHA256=3726060e236c0db3e7124c0a5af123c840ba0cb76682149b63ea0baf290017c2
# renovate: datasource=github-tags depName=docker/cli
DOCKER_VERSION=v29.9.3
DOCKER_SHA256=3fb5d1f13014c18cc54945bc177c58a9056a482dada031e17d12cf2e6922c973
# renovate-hash: depName=docker/compose
COMPOSE_VERSION=v5.7.0
COMPOSE_SHA256=7758048ad38e580f22559603312874fec8bb638d021a9e64182385fc17cc12a2
# renovate-hash: depName=docker/buildx
BUILDX_VERSION=v0.38.2
BUILDX_SHA256=7992ec09413b80ff57ba4e081f56fc833d7bac1d5e71143c6c809e7e6065f6d6
# The GitHub CLI and gitleaks, which agent jobs would otherwise fetch each run.
# renovate-hash: depName=cli/cli
GH_VERSION=v2.103.3
GH_SHA256=4c806978ffce1cec70853302a56d70ac6da4f19bae7adca4e1a8ab00633dd91d
# renovate-hash: depName=gitleaks/gitleaks
GITLEAKS_VERSION=v8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb

# Actions unpacked into the image, so the runner does not download them per job
# (ACTIONS_RUNNER_ACTION_ARCHIVE_CACHE). Exact commits of the tags the CI repos use
# (checkout and upload-artifact v7, then the ones agent jobs use: checkout@v5,
# upload-artifact@v4, download-artifact@v4, create-github-app-token@v2,
# claude-code-action@v1, setup-uv@v6, and homelab's mise-action and cache, which its
# VM jobs skip but the runner still fetches); a tag that has moved on is simply
# downloaded as before.
CACHED_ACTIONS="actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
  actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
  actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 actions/create-github-app-token@fee1f7d63c2ff003460e3d139729b119787bc349
  anthropics/claude-code-action@c0949c50a78c1ec8ce2647db36629b870e715d0c astral-sh/setup-uv@d0cc045d04ccac9d8b7881df0226f9e82c39688e
  jdx/mise-action@b44d12e7d0d8ee7461bb893e1b1993500433185b actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9"
