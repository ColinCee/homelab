// Beelink: /etc/apt/apt.conf.d/52unattended-upgrades-local (install steps in
// docs/runbooks/deploying-services.md). Check a change with
// `sudo unattended-upgrade --dry-run -d`.

Unattended-Upgrade::Allowed-Origins {
	"${distro_id}:${distro_codename}-updates";
};

// Docker, containerd and Tailscale are the host's attack surface, so their
// repos update nightly too. The run starts around 06:00-07:00 UTC; a Docker
// or containerd update restarts every container (no live-restore), and they
// come back on their own. docker-major.pref holds Docker majors. Hold a broken
// release with `sudo apt-mark hold <pkg>`.
// Origins from `apt-cache policy`; Docker's sets no codename, so archive.
Unattended-Upgrade::Origins-Pattern {
	"origin=Docker,archive=noble,label=Docker CE";
	"origin=Tailscale,codename=noble";
	"origin=mise repository";
	"origin=. nodistro";
	"origin=cloud-sdk";
};

// Reboot at 04:00 only when an installed update requires it.
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
Unattended-Upgrade::Automatic-Reboot-Time "04:00";
