[Unit]
Description=Collect files other machines sent with Taildrop, for the nightly backup
Documentation=https://github.com/ColinCee/homelab/blob/main/docs/architecture.md#backups
After=network-online.target

[Service]
Type=oneshot
# Needs `sudo tailscale set --operator=colin` once, so this user may receive files.
ExecStartPre=/usr/bin/mkdir -p %h/pc-backups
ExecStart=/usr/bin/tailscale file get --conflict=overwrite %h/pc-backups
# The newest file's time, for Prometheus (docs/architecture.md, "Backups").
ExecStartPost=/usr/bin/python3 -I %h/code/homelab/stacks/backup/unit_metrics.py pc-received
TimeoutStartSec=30min
Nice=10
