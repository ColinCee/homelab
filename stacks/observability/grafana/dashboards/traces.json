  "panels": [
    {
      "id": 7,
      "type": "nodeGraph",
      "title": "Who calls whom, last hour",
      "description": "Each arrow is one service's calls to another in the last hour, from its traces, and how many failed: answered with a server error or not at all, as the tables below count them. Each end is named by its Compose service, an outside one by the name it was called by, or else as the home network or the internet. Drag to pan.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "spans"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "spans"
          },
          "refId": "edges",
          "expr": "_time:1h kind:=3 | fields span_id, \"resource_attr:service.name\", \"span_attr:peer.service\", \"span_attr:network.peer.address\", \"span_attr:server.address\", \"span_attr:server.port\", \"span_attr:http.response.status_code\", status_code | rename \"resource_attr:service.name\" as source, \"span_attr:peer.service\" as target, \"span_attr:network.peer.address\" as peer, \"span_attr:server.address\" as host, \"span_attr:server.port\" as port, \"span_attr:http.response.status_code\" as http_status | join by (span_id) (_time:1h kind:=2 | fields parent_span_id, \"resource_attr:service.name\" | rename parent_span_id as span_id, \"resource_attr:service.name\" as answered) | join by (port) (_time:1h kind:=2 \"resource_attr:container.network.mode\":=host | stats by (\"span_attr:server.port\") count_uniq(\"resource_attr:service.name\") listeners, min(\"resource_attr:service.name\") listener | filter listeners:=1 | rename \"span_attr:server.port\" as port | delete listeners) | format if (peer:=\"\" host:ipv4_range(\"0.0.0.0/0\")) \"<host>\" as peer | format if (target:=\"\") \"<answered>\" as target | format if (target:=\"\" (peer:ipv4_range(\"127.0.0.0/8\") or peer:ipv4_range(\"100.64.0.0/10\"))) \"<listener>\" as target | format if (target:=\"\" host:~\"[.]\" -host:ipv4_range(\"0.0.0.0/0\")) \"<host>\" as target | format if (target:=\"\" peer:ipv4_range(\"0.0.0.0/0\") -peer:ipv4_range(\"10.0.0.0/8\") -peer:ipv4_range(\"172.16.0.0/12\") -peer:ipv4_range(\"192.168.0.0/16\") -peer:ipv4_range(\"127.0.0.0/8\") -peer:ipv4_range(\"100.64.0.0/10\") -peer:ipv4_range(\"169.254.0.0/16\")) \"internet\" as target | format if (target:=\"\" peer:*) \"home network\" as target | filter target:!=\"\" -target:eq_field(source) | uniq by (span_id, source, target, status_code, http_status) | stats by (source, target) count() calls, count() if (status_code:=2 -http_status:~\"^4\") failed | format \"<source> to <target>\" as id | format \"<calls> calls\" as mainstat | format if (calls:=1) \"1 call\" as mainstat | format \"<failed> failed\" as secondarystat | fields id, source, target, mainstat, secondarystat",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        },
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "spans"
          },
          "refId": "nodes",
          "expr": "_time:1h kind:=3 | fields span_id, \"resource_attr:service.name\", \"span_attr:peer.service\", \"span_attr:network.peer.address\", \"span_attr:server.address\", \"span_attr:server.port\", \"span_attr:http.response.status_code\", status_code | rename \"resource_attr:service.name\" as source, \"span_attr:peer.service\" as target, \"span_attr:network.peer.address\" as peer, \"span_attr:server.address\" as host, \"span_attr:server.port\" as port, \"span_attr:http.response.status_code\" as http_status | join by (span_id) (_time:1h kind:=2 | fields parent_span_id, \"resource_attr:service.name\" | rename parent_span_id as span_id, \"resource_attr:service.name\" as answered) | join by (port) (_time:1h kind:=2 \"resource_attr:container.network.mode\":=host | stats by (\"span_attr:server.port\") count_uniq(\"resource_attr:service.name\") listeners, min(\"resource_attr:service.name\") listener | filter listeners:=1 | rename \"span_attr:server.port\" as port | delete listeners) | format if (peer:=\"\" host:ipv4_range(\"0.0.0.0/0\")) \"<host>\" as peer | format if (target:=\"\") \"<answered>\" as target | format if (target:=\"\" (peer:ipv4_range(\"127.0.0.0/8\") or peer:ipv4_range(\"100.64.0.0/10\"))) \"<listener>\" as target | format if (target:=\"\" host:~\"[.]\" -host:ipv4_range(\"0.0.0.0/0\")) \"<host>\" as target | format if (target:=\"\" peer:ipv4_range(\"0.0.0.0/0\") -peer:ipv4_range(\"10.0.0.0/8\") -peer:ipv4_range(\"172.16.0.0/12\") -peer:ipv4_range(\"192.168.0.0/16\") -peer:ipv4_range(\"127.0.0.0/8\") -peer:ipv4_range(\"100.64.0.0/10\") -peer:ipv4_range(\"169.254.0.0/16\")) \"internet\" as target | format if (target:=\"\" peer:*) \"home network\" as target | filter target:!=\"\" -target:eq_field(source) | uniq by (span_id, source, target, status_code, http_status) | format '[\"<source>\",\"<target>\"]' as id | unroll by (id) | stats by (id) count() if (id:eq_field(target)) answered | format \"<id>\" as title | format if (answered:>0) \"<answered> calls in\" as subtitle | format if (answered:=1) \"1 call in\" as subtitle | fields id, title, subtitle",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": true
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mainstat"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Calls"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "secondarystat"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Failed"
              }
            ]
          }
        ]
      },
      "options": {
        "nodes": {},
        "edges": {},
        "zoomMode": "cooperative",
        "layoutAlgorithm": "layered"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 22
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests an hour, by service",
      "description": "Requests each service answered, counted from its traces.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "spans"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "spans"
          },
          "refId": "A",
          "expr": "kind:=2 | stats by (\"resource_attr:service.name\") count() as requests",
          "legendFormat": "{{resource_attr:service.name}}",
          "queryType": "statsRange",
          "step": "1h",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 10
      },
      "interval": "1h"
    },
    {
      "id": 2,
      "type": "table",
      "title": "Each service, last 24 hours",
      "description": "Requests each service answered in the last 24 hours, how many failed, and how long they took: the median, the time 95 in 100 came under, and the slowest.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "spans"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "spans"
          },
          "refId": "A",
          "expr": "_time:1d kind:=2 | stats by (\"resource_attr:service.name\") count() as requests, count() if (status_code:=2) as failed, median(duration) as typical, quantile(0.95, duration) as most, max(duration) as slowest | sort by (requests) desc | limit 30 | math typical/1e6 as typical, most/1e6 as most, slowest/1e6 as slowest",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 30
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "resource_attr:service.name": true,
              "requests": true,
              "failed": true,
              "typical": true,
              "most": true,
              "slowest": true
            },
            "indexByName": {
              "resource_attr:service.name": 0,
              "requests": 1,
              "failed": 2,
              "typical": 3,
              "most": 4,
              "slowest": 5
            },
            "renameByName": {
              "resource_attr:service.name": "Service",
              "requests": "Requests",
              "failed": "Failed",
              "typical": "Typical",
              "most": "95 in 100 under",
              "slowest": "Slowest"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Requests",
                "destinationType": "number"
              },
              {
                "targetField": "Failed",
                "destinationType": "number"
              },
              {
                "targetField": "Typical",
                "destinationType": "number"
              },
              {
                "targetField": "95 in 100 under",
                "destinationType": "number"
              },
              {
                "targetField": "Slowest",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "minWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Typical|95 in 100 under)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: ms"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Slowest)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: ms"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "#d03b3b",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 10
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Slowest requests, last hour",
      "description": "The requests that took longest in the last hour. Open timeline shows what a request called and where its time went.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "spans"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "spans"
          },
          "refId": "A",
          "expr": "_time:1h kind:=2 | sort by (duration) desc | limit 25 | math duration/1e6 as ms | fields _time, \"resource_attr:service.name\", name, ms, trace_id",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 30
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "Time": true,
              "resource_attr:service.name": true,
              "name": true,
              "ms": true,
              "trace_id": true
            },
            "indexByName": {
              "Time": 0,
              "resource_attr:service.name": 1,
              "name": 2,
              "ms": 3,
              "trace_id": 4
            },
            "renameByName": {
              "Time": "Finished",
              "resource_attr:service.name": "Service",
              "name": "Request",
              "ms": "Took",
              "trace_id": "Steps"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Took",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Finished",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "minWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Finished"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocalNoDateIfToday"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Took)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: ms"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Steps"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".+",
                      "result": {
                        "text": "Open timeline",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the request's timeline",
                    "url": "/explore?schemaVersion=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22traces%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22jaeger%22%2C%22uid%22%3A%22traces%22%7D%2C%22query%22%3A%22${__value.raw}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D&orgId=1"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 12
      }
    },
