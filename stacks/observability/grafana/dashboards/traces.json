{
  "uid": "traces",
  "title": "Traces",
  "description": "What did each service answer, and how long did it take? CI's runs are on the CI page.",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "tags": [
    "homelab"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "refresh": "5m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "spans"
        },
        "enable": true,
        "iconColor": "#898781",
        "target": {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "spans"
          },
          "refId": "Deploys",
          "expr": "\"resource_attr:service.name\":=deploy name:=deploy parent_span_id:=\"\" | rename \"span_attr:commit\" as commit, \"span_attr:stacks\" as stacks | format if (status_code:=2) \"failed\" as result | format if (status_code:!=2) \"deployed\" as result | format \"LTa href=QThttps://github.com/ColinCee/homelab/commit/<commit>QTGTCommit <commit>LT/aGT: <result> <stacks>\" as _msg | replace (\"LT\", \"<\") at _msg | replace (\"GT\", \">\") at _msg | replace (\"QT\", '\"') at _msg | fields _time, _msg",
          "queryType": "raw",
          "editorMode": "code",
          "maxLines": 100
        },
        "mappings": {
          "text": {
            "source": "field",
            "value": "Line"
          }
        }
      }
    ]
  },
