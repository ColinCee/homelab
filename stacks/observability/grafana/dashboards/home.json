    {
      "id": 13,
      "type": "timeseries",
      "title": "Memory by group",
      "description": "The stack's top is the host's own figure in use. Monitoring is the observability stack; Apps every other container; System the rest.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(max by (name, container_label_com_docker_compose_project) (container_memory_working_set_bytes{job=\"docker\",name!=\"\",container_label_com_docker_compose_project=\"observability\"})) or vector(0))",
          "legendFormat": "Monitoring"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "clamp_min(max(node_memory_MemTotal_bytes{job=\"integrations/unix\"} - node_memory_MemAvailable_bytes{job=\"integrations/unix\"}) - sum(max by (name, container_label_com_docker_compose_project) (container_memory_working_set_bytes{job=\"docker\",name!=\"\"})), 0)",
          "legendFormat": "System"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(max by (name, container_label_com_docker_compose_project) (container_memory_working_set_bytes{job=\"docker\",name!=\"\"})) - (sum(max by (name, container_label_com_docker_compose_project) (container_memory_working_set_bytes{job=\"docker\",name!=\"\",container_label_com_docker_compose_project=\"observability\"})) or vector(0))",
          "legendFormat": "Apps"
        }
      ],
      "fieldConfig": {
        "defaults": {
