  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Flight tracker",
      "description": "How long it has been up, or in red how long down, looking back 7 days. Down means the public site does not answer with live data.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(((time() - max_over_time(timestamp((max(probe_success{job=\"integrations/blackbox/flight-tracker\"}) or vector(0)) < 1)[7d:1m])) and on() ((max(probe_success{job=\"integrations/blackbox/flight-tracker\"}) or vector(0)) == 1)) or ((time() - min_over_time(timestamp(max(probe_success{job=\"integrations/blackbox/flight-tracker\"}))[7d:1m])) and on() ((max(probe_success{job=\"integrations/blackbox/flight-tracker\"}) or vector(0)) == 1)) or -(time() - max_over_time(timestamp((max(probe_success{job=\"integrations/blackbox/flight-tracker\"}) or vector(0)) == 1)[7d:1m])) or vector(-604800)) >= 0",
          "legendFormat": "Up",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "-((((time() - max_over_time(timestamp((max(probe_success{job=\"integrations/blackbox/flight-tracker\"}) or vector(0)) < 1)[7d:1m])) and on() ((max(probe_success{job=\"integrations/blackbox/flight-tracker\"}) or vector(0)) == 1)) or ((time() - min_over_time(timestamp(max(probe_success{job=\"integrations/blackbox/flight-tracker\"}))[7d:1m])) and on() ((max(probe_success{job=\"integrations/blackbox/flight-tracker\"}) or vector(0)) == 1)) or -(time() - max_over_time(timestamp((max(probe_success{job=\"integrations/blackbox/flight-tracker\"}) or vector(0)) == 1)[7d:1m])) or vector(-604800)) < 0)",
          "legendFormat": "Down",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2f8f46",
                "value": null
              }
            ]
          },
          "mappings": [],
          "links": [
            {
              "title": "Open Services",
              "url": "/d/services",
              "oneClick": true
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Down"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d03b3b"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "wideLayout": false,
        "showPercentChange": false,
        "text": {
          "titleSize": 14,
          "valueSize": 26
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Home Assistant",
      "description": "How long it has been up, or in red how long down, looking back 7 days. Up means its container runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(((time() - max(max by (name) (container_start_time_seconds{job=\"docker\",name=~\"homeassistant\"}))) and on() (count(max by (name) (container_start_time_seconds{job=\"docker\",name=~\"homeassistant\"})) == 1)) or -(time() - min(max by (name) (last_over_time(container_last_seen{job=\"docker\",name=~\"homeassistant\"}[7d])))) or vector(-604800)) >= 0",
          "legendFormat": "Up",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "-((((time() - max(max by (name) (container_start_time_seconds{job=\"docker\",name=~\"homeassistant\"}))) and on() (count(max by (name) (container_start_time_seconds{job=\"docker\",name=~\"homeassistant\"})) == 1)) or -(time() - min(max by (name) (last_over_time(container_last_seen{job=\"docker\",name=~\"homeassistant\"}[7d])))) or vector(-604800)) < 0)",
          "legendFormat": "Down",
          "instant": true,
          "range": false
