    {
      "id": 11,
      "type": "gauge",
      "title": "CI vs usual",
      "description": "The latest run on main of the job furthest over its 14-day median, as a share of that median; amber past 150% when that is also 20 s more, the line CI on main got slower draws for a day's median.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(100 * (max by (workflow, ci_job, runner) (homelab_ci_job_seconds{kind=\"main\"}) / max by (workflow, ci_job, runner) (quantile_over_time(0.5, homelab_ci_job_seconds{kind=\"main\"}[14d])) and max by (workflow, ci_job, runner) (homelab_ci_job_seconds{kind=\"main\"}) > 20 + max by (workflow, ci_job, runner) (quantile_over_time(0.5, homelab_ci_job_seconds{kind=\"main\"}[14d])))) or max(100 * clamp_max(max by (workflow, ci_job, runner) (homelab_ci_job_seconds{kind=\"main\"}) / max by (workflow, ci_job, runner) (quantile_over_time(0.5, homelab_ci_job_seconds{kind=\"main\"}[14d])), 1.49))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
