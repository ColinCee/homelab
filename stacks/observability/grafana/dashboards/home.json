    {
      "id": 12,
      "type": "table",
      "title": "Firing now",
      "description": "Each alert rule firing now, its level and when it began; empty when none fires. The Services page lists what fired earlier.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (alertname, level) (ALERTS{alertstate=\"firing\",alertname!=\"watchdog\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (alertname) (ALERTS_FOR_STATE{alertname!=\"watchdog\"}) * 1000 and on (alertname) ALERTS{alertstate=\"firing\",alertname!=\"watchdog\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "alertname": 0,
              "level": 1,
              "Value #B": 2
            },
            "renameByName": {
              "alertname": "Rule",
              "level": "Level",
              "Value #B": "Since"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocalNoDateIfToday"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Level"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "now": {
                        "text": "now",
                        "color": "#d03b3b",
                        "index": 0
                      },
                      "week": {
                        "text": "week",
                        "color": "#fab219",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 15,
        "y": 4,
        "w": 9,
        "h": 7
      }
