  "panels": [
    {
      "type": "state-timeline",
      "title": "Each service, running or stopped",
      "description": "Every service the last deploy started to keep running: gray while its container runs, red while it does not.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(max by (project, service) (homelab_container_expected) and on (project, service) label_replace(label_replace(container_last_seen{job=\"docker\",container_label_com_docker_compose_oneoff=\"False\"}, \"project\", \"$1\", \"container_label_com_docker_compose_project\", \"(.+)\"), \"service\", \"$1\", \"container_label_com_docker_compose_service\", \"(.+)\")) or (max by (project, service) (homelab_container_expected) * 0 unless on (project, service) label_replace(label_replace(container_last_seen{job=\"docker\",container_label_com_docker_compose_oneoff=\"False\"}, \"project\", \"$1\", \"container_label_com_docker_compose_project\", \"(.+)\"), \"service\", \"$1\", \"container_label_com_docker_compose_service\", \"(.+)\"))",
          "legendFormat": "{{project}} / {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#898781"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Stopped",
                  "color": "#d03b3b",
                  "index": 0
                },
                "1": {
                  "text": "Running",
                  "color": "#898781",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 14
      },
      "id": 1
    },
    {
      "type": "row",
      "title": "Errors in the logs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 2
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error lines per hour, by container",
      "description": "Lines that log an error, a fatal or a Python exception. Alloy resends a container's recent lines when it restarts; this chart counts those twice (stats over a range cannot drop repeats first), the table below does not.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "logs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "logs"
          },
          "refId": "A",
          "expr": "(i(error) or i(fatal) or i(panic) or i(crit) or i(critical) or i(exception) or i(limited)) (level:in(error, fatal, critical) or _msg:~`^.{0,40}\\b(ERROR|FATAL|PANIC|CRITICAL)\\b|(?i:level=(error|fatal|crit))|^(\\w+\\.)+[A-Z]\\w*: |^[A-Z]\\w*(Error|Exception): `) | stats by (container_name) count() as lines",
          "legendFormat": "{{container_name}}",
          "queryType": "statsRange",
          "step": "1h",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#898781"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^observability-/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(backup|homeassistant|flight-tracker-.+|internal-names-.+)$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 7
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Most repeated error lines, last hour",
      "description": "Numbers and ids show as #, so repeats of one error count together; each line is cut at 80 characters.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "logs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "logs"
          },
          "refId": "A",
          "expr": "_time:1h (i(error) or i(fatal) or i(panic) or i(crit) or i(critical) or i(exception) or i(limited)) (level:in(error, fatal, critical) or _msg:~`^.{0,40}\\b(ERROR|FATAL|PANIC|CRITICAL)\\b|(?i:level=(error|fatal|crit))|^(\\w+\\.)+[A-Z]\\w*: |^[A-Z]\\w*(Error|Exception): `) | uniq by (_time, container_name, _msg) | replace_regexp (\"^observability-|-1$\", \"\") at container_name | replace_regexp (`\\x1b\\[[0-9;]*m|^\\S*\\d{4}-\\d\\d-\\d\\d[T ][0-9:.,]+\\S*\\s*`, \"\") at _msg | replace_regexp (\"[0-9a-f]*[0-9][0-9a-f]*\", \"#\") at _msg | extract_regexp `^(?P<line>.{0,80})` from _msg | stats by (container_name, line) count() as hits | sort by (hits desc) limit 20",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 20
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "container_name": true,
              "line": true,
              "hits": true
            },
            "indexByName": {
              "container_name": 0,
              "line": 1,
              "hits": 2
            },
            "renameByName": {
              "container_name": "Container",
              "line": "Line",
              "hits": "Lines"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Lines",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Lines",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Line"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 900
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 9
      }
    },
    {
      "type": "row",
      "title": "Alerts",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 5
    },
    {
      "id": 6,
      "type": "table",
      "title": "Alerts that fired",
      "description": "Each rule that fired in the time range, first and last minute it fired, and its minutes firing; still firing if its last time is this minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (alertname) (max_over_time(timestamp(ALERTS{alertstate=\"firing\",alertname!=\"watchdog\"})[$__range:1m])) * 1000",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "min by (alertname) (min_over_time(timestamp(ALERTS{alertstate=\"firing\",alertname!=\"watchdog\"})[$__range:1m])) * 1000",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum by (alertname) (count_over_time(ALERTS{alertstate=\"firing\",alertname!=\"watchdog\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "alertname": 0,
              "Value #B": 1,
              "Value #A": 2,
              "Value #C": 3
            },
            "renameByName": {
              "alertname": "Rule",
              "Value #B": "First",
              "Value #A": "Last",
              "Value #C": "Minutes firing"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Last",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "First|Last"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocalNoDateIfToday"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 15,
        "h": 9
      }
    },
