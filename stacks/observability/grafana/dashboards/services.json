    {
      "id": 13,
      "type": "table",
      "title": "Alerts that fired",
      "description": "Each rule that fired in the time range, first and last minute it fired, and its minutes firing; still firing if its last time is this minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (alertname) (max_over_time(timestamp(ALERTS{alertstate=\"firing\",alertname!=\"watchdog\"})[$__range:1m])) * 1000",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "min by (alertname) (min_over_time(timestamp(ALERTS{alertstate=\"firing\",alertname!=\"watchdog\"})[$__range:1m])) * 1000",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum by (alertname) (count_over_time(ALERTS{alertstate=\"firing\",alertname!=\"watchdog\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "alertname": 0,
              "Value #B": 1,
              "Value #A": 2,
              "Value #C": 3
            },
            "renameByName": {
              "alertname": "Rule",
              "Value #B": "First",
              "Value #A": "Last",
              "Value #C": "Minutes firing"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Last",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
