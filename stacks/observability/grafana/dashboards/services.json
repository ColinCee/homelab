  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Services stopped",
      "description": "Services the last deploy started to keep running that have no running container; A service stopped fires after 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count(max by (project, service) (homelab_container_expected) * 0 unless on (project, service) label_replace(label_replace(container_last_seen{job=\"docker\",container_label_com_docker_compose_oneoff=\"False\"}, \"project\", \"$1\", \"container_label_com_docker_compose_project\", \"(.+)\"), \"service\", \"$1\", \"container_label_com_docker_compose_service\", \"(.+)\")) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2f8f46",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 14,
          "valueSize": 26
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alerts firing",
      "description": "Alert rules firing now; a rule with several firing series counts once.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count(count by (alertname) (ALERTS{alertstate=\"firing\",alertname!=\"watchdog\"})) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2f8f46",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 14,
          "valueSize": 26
        }
      },
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 4
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Firing now",
      "description": "Each alert rule firing now, its level and when it began; empty when none fires. The Services page lists what fired earlier.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (alertname, level) (ALERTS{alertstate=\"firing\",alertname!=\"watchdog\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (alertname) (ALERTS_FOR_STATE{alertname!=\"watchdog\"}) * 1000 and on (alertname) ALERTS{alertstate=\"firing\",alertname!=\"watchdog\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "alertname": 0,
              "level": 1,
              "Value #B": 2
            },
            "renameByName": {
              "alertname": "Rule",
              "level": "Level",
              "Value #B": "Since"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocalNoDateIfToday"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Level"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "now": {
                        "text": "now",
                        "color": "#d03b3b",
                        "index": 0
                      },
                      "week": {
                        "text": "week",
                        "color": "#fab219",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 10,
        "h": 4
      }
    },
    {
      "type": "state-timeline",
      "title": "Each service, running or stopped",
      "description": "Every service the last deploy started to keep running: green while its container runs, red while it does not.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(max by (project, service) (homelab_container_expected) and on (project, service) label_replace(label_replace(container_last_seen{job=\"docker\",container_label_com_docker_compose_oneoff=\"False\"}, \"project\", \"$1\", \"container_label_com_docker_compose_project\", \"(.+)\"), \"service\", \"$1\", \"container_label_com_docker_compose_service\", \"(.+)\")) or (max by (project, service) (homelab_container_expected) * 0 unless on (project, service) label_replace(label_replace(container_last_seen{job=\"docker\",container_label_com_docker_compose_oneoff=\"False\"}, \"project\", \"$1\", \"container_label_com_docker_compose_project\", \"(.+)\"), \"service\", \"$1\", \"container_label_com_docker_compose_service\", \"(.+)\"))",
          "legendFormat": "{{project}} / {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#898781"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Stopped",
                  "color": "#d03b3b",
                  "index": 0
                },
                "1": {
                  "text": "Running",
                  "color": "#2f8f46",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 14
      },
      "id": 4
    },
    {
