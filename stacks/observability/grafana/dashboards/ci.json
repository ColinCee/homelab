  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "CI vs usual",
      "description": "The latest run on main of the job furthest over its 14-day median, as a share of that median; amber past 150% when that is also 20 s more, the line CI on main got slower draws for a day's median.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(100 * (max by (workflow, ci_job, runner) (homelab_ci_job_seconds{kind=\"main\"}) / max by (workflow, ci_job, runner) (quantile_over_time(0.5, homelab_ci_job_seconds{kind=\"main\"}[14d])) and max by (workflow, ci_job, runner) (homelab_ci_job_seconds{kind=\"main\"}) > 20 + max by (workflow, ci_job, runner) (quantile_over_time(0.5, homelab_ci_job_seconds{kind=\"main\"}[14d])))) or max(100 * clamp_max(max by (workflow, ci_job, runner) (homelab_ci_job_seconds{kind=\"main\"}) / max by (workflow, ci_job, runner) (quantile_over_time(0.5, homelab_ci_job_seconds{kind=\"main\"}[14d])), 1.49))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2f8f46",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 150
              }
            ]
          },
          "mappings": [],
          "min": 0,
          "max": 200
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "minVizWidth": 75,
        "minVizHeight": 75,
        "shape": "gauge",
        "sparkline": true
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 7
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "VMs busy",
      "description": "Share of the host's CI VM slots running a job now, across every served repo; amber when every slot is busy and the next job waits.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "100 * max(homelab_ci_vms_busy) / max(homelab_ci_vm_slots)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2f8f46",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 100
              }
            ]
          },
          "mappings": [],
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "minVizWidth": 75,
        "minVizHeight": 75,
        "shape": "gauge",
        "sparkline": true
      },
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 7
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Queue wait",
      "description": "How long the longest-waiting queued job has waited so far, across every served repo; 0 when nothing waits, amber past 2 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(homelab_ci_wait_seconds)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2f8f46",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 120
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 14,
          "valueSize": 26
        }
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 7
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Memory kills",
      "description": "Processes the kernel killed inside CI VMs for memory, over the last 7 days.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(homelab_ci_vm_oom_kills_total[7d])) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2f8f46",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 14,
          "valueSize": 26
        }
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 7
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Each job on main, latest against usual",
      "description": "The latest good run's time for each job on main, beside its median over 14 days. This repo's workflows only.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (workflow, ci_job, runner) (homelab_ci_job_seconds{kind=\"main\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (workflow, ci_job, runner) (quantile_over_time(0.5, homelab_ci_job_seconds{kind=\"main\"}[14d]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Against usual",
            "mode": "binary",
            "binary": {
              "left": "Value #A",
              "operator": "/",
              "right": "Value #B"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "workflow": 0,
              "ci_job": 1,
              "runner": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Against usual": 5
            },
            "renameByName": {
              "workflow": "Workflow",
              "ci_job": "Job",
              "runner": "Runs on",
              "Value #A": "Latest",
              "Value #B": "Usual"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Latest",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "minWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Latest|Usual$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Against usual"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#2f8f46",
                      "value": null
                    },
                    {
                      "color": "#fab219",
                      "value": 1.5
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Job time on main",
      "description": "Each job's latest good run on main, held until its next run, so a step up that stays up is a job that got slower. Blue runs in a CI VM, orange on GitHub, aqua on the Beelink.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (workflow, ci_job, runner) (homelab_ci_job_seconds{kind=\"main\"})",
          "legendFormat": "{{workflow}}: {{ci_job}} on {{runner}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#898781"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ on vm$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ on github$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ on beelink$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 9
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Job time on pull requests",
      "description": "Each job's latest good run on a pull request, held until its next run.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (workflow, ci_job, runner) (homelab_ci_job_seconds{kind=\"pr\"})",
          "legendFormat": "{{workflow}}: {{ci_job}} on {{runner}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#898781"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ on vm$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ on github$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ on beelink$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 9
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Recent runs",
      "description": "This repo's latest CI and deploy runs. Open timeline shows a run's jobs, steps, tasks and slowest tests, each with its time.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "spans"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "spans"
          },
          "refId": "A",
          "expr": "_time:7d \"resource_attr:service.name\":=ci \"span_attr:event\":* | sort by (_time) desc | limit 30 | math duration/1e9 as seconds | fields _time, name, \"span_attr:branch\", \"span_attr:conclusion\", seconds, trace_id, \"span_attr:url\"",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 30
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "Time": true,
              "name": true,
              "span_attr:branch": true,
              "span_attr:conclusion": true,
              "seconds": true,
              "trace_id": true,
              "span_attr:url": true
            },
            "indexByName": {
              "Time": 0,
              "name": 1,
              "span_attr:branch": 2,
              "span_attr:conclusion": 3,
              "seconds": 4,
              "trace_id": 5,
              "span_attr:url": 6
            },
            "renameByName": {
              "Time": "Finished",
              "name": "Workflow",
              "span_attr:branch": "Branch",
              "span_attr:conclusion": "Result",
              "seconds": "Took",
              "trace_id": "Steps",
              "span_attr:url": "GitHub"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Took",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Finished",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "minWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Finished"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocalNoDateIfToday"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Took)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Result"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "text": "passed",
                        "color": "#2f8f46",
                        "index": 0
                      },
                      "failure": {
                        "text": "failed",
                        "color": "#d03b3b",
                        "index": 1
                      },
                      "cancelled": {
                        "text": "cancelled",
                        "color": "#898781",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Steps"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
