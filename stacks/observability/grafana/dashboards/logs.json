{
  "uid": "logs",
  "title": "Logs",
  "description": "What are the services saying?",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "tags": [
    "homelab"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "logs"
        },
        "query": {
          "refId": "A",
          "type": "fieldValue",
          "field": "container_name",
          "query": "*"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "search",
        "label": "Words to find",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Home",
      "url": "/d/home",
      "icon": "dashboard",
      "tags": [],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false,
      "tooltip": ""
    },
    {
      "type": "link",
      "title": "Server",
      "url": "/d/server",
      "icon": "dashboard",
      "tags": [],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false,
      "tooltip": ""
    },
    {
      "type": "link",
      "title": "Services",
      "url": "/d/services",
      "icon": "dashboard",
      "tags": [],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false,
      "tooltip": ""
    },
    {
      "type": "link",
      "title": "CI",
      "url": "/d/ci",
      "icon": "dashboard",
      "tags": [],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false,
      "tooltip": ""
    },
    {
      "type": "link",
      "title": "Logs",
      "url": "/d/logs",
      "icon": "doc",
      "tags": [],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false,
      "tooltip": ""
    },
    {
      "type": "link",
      "title": "Traces",
      "url": "/d/traces",
      "icon": "bolt",
      "tags": [],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false,
      "tooltip": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Lines an hour, by container",
      "description": "Log lines each chosen container wrote. Alloy resends a container's recent lines when it restarts, and this chart counts those twice.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "logs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "logs"
          },
          "refId": "A",
          "expr": "container_name:~\"${container:regex}\" ${search} | stats by (container_name) count() as lines",
          "legendFormat": "{{container_name}}",
          "queryType": "statsRange",
          "step": "1h",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#898781"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^observability-/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(backup|homeassistant|deploy-.+|flight-tracker-.+|internal-names-.+|oncall-.+|tunnel-.+)$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Lines, newest first",
      "description": "The latest 500 lines of the chosen containers that hold the words searched for. A line with a trace opens it.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "logs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "logs"
          },
          "refId": "A",
          "expr": "container_name:~\"${container:regex}\" ${search} | fields _time, _msg, container_name, level, trace_id",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 22
      },
      "id": 2
    }
  ]
}
