    {
      "id": 20,
      "type": "table",
      "title": "Runs",
      "description": "Each day's run in the time range (pick a longer one for more): how it ended, empty if it stopped before saying, when it started and finished, and how many deep checks read every byte back.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "logs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "logs"
          },
          "refId": "A",
          "expr": "container_name:=\"backup\" | uniq by (_time, _msg) | stats by (_time:1d) min(_time) as started, max(_msg) if (_msg:~\"^backup (ok|FAILED|SKIPPED)\") as result, max(_time) if (_msg:~\"^backup (ok|FAILED|SKIPPED)\") as finished, count() if (_msg:=\"deep check ok\") as deep_checks | sort by (started desc)",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 100
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "started": true,
              "result": true,
              "finished": true,
              "deep_checks": true
            },
            "indexByName": {
              "started": 0,
              "result": 1,
              "finished": 2,
              "deep_checks": 3
            },
            "renameByName": {
              "started": "Started",
              "result": "Result",
              "finished": "Finished",
              "deep_checks": "Deep checks"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
