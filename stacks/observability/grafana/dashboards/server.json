    {
      "id": 12,
      "type": "timeseries",
      "title": "Network checks, a second",
      "description": "Retried connection attempts, resets sent and connections dropped while queued: each climbs when something cannot connect.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(node_netstat_TcpExt_TCPSynRetrans{job=\"integrations/unix\"}[5m]))",
          "legendFormat": "SYN retransmits"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(node_netstat_Tcp_OutRsts{job=\"integrations/unix\"}[5m]))",
          "legendFormat": "TCP resets out"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(rate(node_netstat_TcpExt_ListenDrops{job=\"integrations/unix\"}[5m]))",
          "legendFormat": "Listen drops"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#898781"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SYN retransmits"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TCP resets out"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
