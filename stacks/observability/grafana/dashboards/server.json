    {
      "id": 10,
      "type": "timeseries",
      "title": "Traffic, bytes a second",
      "description": "The host's wired network and Tailscale, in and out.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (interface) (rate(container_network_receive_bytes_total{job=\"docker\",id=\"/\",interface=~\"enp1s0|tailscale0\"}[5m]))",
          "legendFormat": "{{interface}} in"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (interface) (rate(container_network_transmit_bytes_total{job=\"docker\",id=\"/\",interface=~\"enp1s0|tailscale0\"}[5m]))",
          "legendFormat": "{{interface}} out"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#898781"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "enp1s0 in"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tailscale0 in"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "enp1s0 out"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tailscale0 out"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
