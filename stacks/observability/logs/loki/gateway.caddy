# Loki's read paths (../../gateway/Caddyfile imports the chosen store's file). Loki has no per-path auth, and its
# GETs include `/flush`, `/config` and `/ingester/shutdown`, which stops it.
@logs {
	vars {reader} agents
	method GET POST
	expression `{http.request.uri.path}.matches("^/logs/loki/api/v1/(query|query_range|labels|label/[a-zA-Z_][a-zA-Z0-9_]*/values|series|index/stats|index/volume|index/volume_range|detected_labels|detected_fields|detected_field/[a-zA-Z_][a-zA-Z0-9_.]*/values|patterns|status/buildinfo)$") && !{http.request.uri.path}.contains("..")`
}
handle @logs {
	uri strip_prefix /logs
	reverse_proxy {$LOGS:logs:3100}
}
