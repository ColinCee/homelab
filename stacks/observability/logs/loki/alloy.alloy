// The log store when it is Loki (../../compose.yaml mounts the chosen store's file beside config.alloy).
otelcol.exporter.otlphttp "logs" {
  client {
    endpoint = "http://logs:3100/otlp"
  }
  // A store down for an outage or a deploy loses nothing while Alloy runs: it keeps trying for an hour, holding up to
  // 10,000 batches.
  retry_on_failure {
    max_elapsed_time = "1h"
  }
  sending_queue {
    queue_size = 10000
  }
}

// Its own metrics, for the rules that notice it down or no longer taking data (prometheus/rules.yml, group stores).
prometheus.scrape "logs" {
  targets         = [{ __address__ = "logs:3100" }]
  job_name        = "logs"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}
