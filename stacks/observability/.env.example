# The log store and the trace store (docs/adr/0004-prometheus-grafana.md): loki or victorialogs, tempo or
# victoriatraces, each a folder under logs/ or traces/.
LOG_STORE=victorialogs
TRACE_STORE=tempo
DISCORD_PRIVATE_WEBHOOK_URL=${DISCORD_PRIVATE_WEBHOOK_URL}
PUBLIC_STATS_KEY=${PUBLIC_STATS_KEY}
# The secrets kept their OpenObserve names, so the switch needed no new secret.
GRAFANA_ADMIN_PASSWORD=${OPENOBSERVE_ROOT_PASSWORD}
# Unused since OpenObserve left, so it can be Grafana's key without sharing a value.
GRAFANA_SECRET_KEY=${OPENOBSERVE_INGEST_PASSWORD}
STATS_PASSWORD=${OPENOBSERVE_STATS_PASSWORD}
AGENTS_PASSWORD=${OPENOBSERVE_AGENTS_PASSWORD}
