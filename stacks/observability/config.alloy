logging {
  format = "json"
}

// ================================
// Alloy's own metrics
// ================================

// What it receives, queues, retries and drops on the way to each store.
prometheus.exporter.self "alloy" {}

// Its targets carry `job="integrations/self"`, which job_name does not replace.
discovery.relabel "alloy" {
  targets = prometheus.exporter.self.alloy.targets

  rule {
    target_label = "job"
    replacement  = "alloy"
  }
}

prometheus.scrape "alloy" {
  targets         = discovery.relabel.alloy.output
  job_name        = "alloy"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// ================================
// Host Metrics (node_exporter)
// ================================

prometheus.exporter.unix "host" {
  procfs_path = "/rootfs/proc"
  sysfs_path  = "/sys"
  // No host folder for the disk's free space: Alloy's own root is on the host's root disk with Docker's data, so it
  // reports the same. Every other mount would need its folder mounted, so only the root disk is read.
  rootfs_path = "/"

  filesystem {
    mount_points_exclude = "^/.+"
  }

  // *.prom files written by other stacks, e.g. the backup success timestamp.
  textfile {
    directory = "/var/lib/homelab-metrics"
  }
}

prometheus.scrape "host" {
  targets    = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.remote_write.default.receiver]

  scrape_interval = "15s"
}

// ================================
// Container Metrics (cAdvisor)
// ================================

prometheus.exporter.cadvisor "docker" {
  docker_only = true
  docker_host = "tcp://docker-socket-proxy:2375"
  // Each Docker label is a label on every series. These tell containers apart; the rest are hashes and paths
  // that would start new series on every deploy.
  store_container_labels       = false
  allowlisted_container_labels = [
    "com.docker.compose.project",
    "com.docker.compose.service",
    "com.docker.compose.container-number",
    "com.docker.compose.oneoff",
  ]
  // cAdvisor's default set, which this list replaces, and disk usage ("disk"): Alloy has no host folder under
  // /rootfs/var/lib/docker but the layer IDs, so it read none and logged an error for each container every few
  // minutes. Its only series were the root cgroup's mounts, as the host scrape's. Each container's disk I/O ("diskIO")
  // stays.
  disabled_metrics = [
    "advtcp", "cpu_topology", "cpuset", "hugetlb", "memory_numa", "process", "referenced_memory", "resctrl", "sched",
    "tcp", "udp", "disk",
  ]
}

discovery.relabel "cadvisor" {
  targets = prometheus.exporter.cadvisor.docker.targets

  rule {
    target_label = "job"
    replacement  = "docker"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

prometheus.scrape "cadvisor" {
  targets    = discovery.relabel.cadvisor.output
  forward_to = [prometheus.remote_write.default.receiver]

  scrape_interval = "15s"
  // cAdvisor stamps each sample with when it last read that cgroup, which differs on every series; the scrape's own
  // time compresses better.
  honor_timestamps = false
}

// ================================
// CI VM Metrics (cAdvisor)
// ================================

// The Firecracker CI VMs are processes, not containers: each runs in its slot's
// cgroup, /firecracker/ci-slotN, which exists only while that slot has a VM.
// No docker_host: with no Docker socket in this container it skips containers,
// which the exporter above already collects.
prometheus.exporter.cadvisor "ci_vms" {
  docker_only                 = false
  enabled_metrics             = ["cpu", "memory"]
  raw_cgroup_prefix_allowlist = ["/firecracker/"]
}

discovery.relabel "ci_vms" {
  targets = prometheus.exporter.cadvisor.ci_vms.targets

  rule {
    target_label = "job"
    replacement  = "homelab-ci-vm"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

prometheus.scrape "ci_vms" {
  targets    = discovery.relabel.ci_vms.output
  forward_to = [prometheus.relabel.ci_vms.receiver]

  scrape_interval = "15s"
  // As for the containers above.
  honor_timestamps = false
}

// Only the VMs' own cgroups; this exporter also reports the whole machine,
// which the host scrape already covers.
prometheus.relabel "ci_vms" {
  forward_to = [prometheus.remote_write.default.receiver]

  rule {
    source_labels = ["id"]
    regex         = "/firecracker/.+"
    action        = "keep"
  }
}

// ================================
// Metrics Destination (Prometheus)
// ================================

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ================================
// Container Log Discovery
// ================================

discovery.docker "containers" {
  host = "tcp://docker-socket-proxy:2375"
}

discovery.relabel "docker_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }
  rule {
    source_labels = ["__meta_docker_container_image_name"]
    target_label  = "image"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
  // As the trace store's `service.name` and Prometheus's `job`, so a service is found by one name in each store; the
  // Compose project tells apart two services of one name.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "service_namespace"
  }
}

// ================================
// Container Logs (Docker)
// ================================

loki.source.docker "containers" {
  host          = "tcp://docker-socket-proxy:2375"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.docker_logs.rules
  forward_to    = [loki.process.noise.receiver]
}

// Lines dropped before the secret filter, which costs the most per line.
loki.process "noise" {
  forward_to = [loki.secretfilter.docker.receiver]

  // Lines already stored. A container's log is read again from the start of the second of its last line
  // (loki.source.docker keeps whole seconds), whenever the socket proxy cuts a stream idle for 10 minutes and when Alloy
  // starts, so a quiet container's last line came again every 10 minutes. A line read live is under a second old; a
  // line written while Alloy was down, or held up in it, for longer than this is lost.
  stage.drop {
    older_than          = "5m"
    drop_counter_reason = "read_again"
  }

  // Alloy's and OBI's polls, answered: nearly every line the log store would take. Refusals (403) and errors stay.
  stage.match {
    selector = "{container_name=\"observability-docker-socket-proxy-1\"}"

    stage.drop {
      expression = "\\s[0-9/]+ (200|404) \\d+ "
    }
  }
}

// As loki.secretfilter "logs" below, but before the fields of each line are copied out (next block).
loki.secretfilter "docker" {
  redact_percent = 100
  forward_to     = [loki.process.docker.receiver]
}

loki.process "docker" {
  forward_to = [otelcol.receiver.loki.logs.receiver, loki.process.error_lines.receiver]

  // Every program that can logs JSON (compose.yaml, each one's log format flag), under its own names for the logger.
  // A line's trace, under the names OpenTelemetry's loggers use, so Grafana links it to the trace store.
  stage.json {
    expressions = {
      level    = "level",
      logger   = "logger || component || source || caller",
      trace_id = "trace_id || traceId || otelTraceID",
      span_id  = "span_id || spanId || otelSpanID",
    }
  }

  // The NULs OBI leaves where it took a line to write it again with its trace.
  stage.drop {
    expression = "^[\\x00\\s]*$"
  }

  // Terminal colours, which Home Assistant writes around each line.
  stage.replace {
    expression = "(\\x1b\\[[0-9;]*m)"
    replace    = ""
  }

  // Each line's level, for the programs that cannot log JSON: CoreDNS (`[INFO]`), Home Assistant
  // (`<date> <time> WARNING (`), and a journal line written so. A JSON line keeps its own, whatever its text says.
  stage.match {
    selector = "{container_name=~\".+\"} !~ \"^[{]\""

    stage.regex {
      expression = "^\\[(?P<level>DEBUG|INFO|WARNING|ERROR|FATAL)\\] "
    }
    stage.regex {
      expression = "^\\S+ \\S+ (?P<level>DEBUG|INFO|WARNING|ERROR|CRITICAL) \\("
    }
  }

  // One vocabulary, the journal's included (loki.relabel "journal"), which the Services dashboard's error counts read.
  stage.template {
    source   = "level"
    template = "{{ $l := ToLower .Value }}{{ get (dict \"emerg\" \"fatal\" \"alert\" \"fatal\" \"crit\" \"fatal\" \"critical\" \"fatal\" \"fatal\" \"fatal\" \"ftl\" \"fatal\" \"panic\" \"fatal\" \"err\" \"error\" \"error\" \"error\" \"eror\" \"error\" \"warn\" \"warn\" \"warning\" \"warn\" \"wrn\" \"warn\" \"info\" \"info\" \"inf\" \"info\" \"notice\" \"info\" \"debug\" \"debug\" \"dbg\" \"debug\" \"trace\" \"debug\") $l | default $l }}"
  }

  // Lines a program logs as errors that are not faults, where it has no setting for their level. Errors are bugs
  // (docs/architecture.md, "Monitoring and alerts"): each mapping names its service and says why above it, which
  // alloy_test.py checks.

  // cloudflared's graceful stop at each deploy, logged as errors (supervisor/supervisor.go, Err(nil)); a lost
  // connection carries its "error".
  stage.match {
    selector = `{service_name="cloudflared"} |~ "\"message\":\"(Connection terminated|no more connections active and exiting)\"" !~ "\"error\":"`

    stage.template {
      source   = "level"
      template = "info"
    }
  }

  // Alloy's log reader reconnecting to a container Docker is removing: its lines were read, and it stops tailing it.
  stage.match {
    selector = `{service_name="alloy"} |~ "can not get logs from container which is dead or marked for removal|could not inspect container info.*No such container"`

    stage.template {
      source   = "level"
      template = "warn"
    }
  }

  // Grafana logs each request the browser cancelled (leaving or refreshing a page) and its stop as errors. Its API
  // server answers one it left (the page history a closing tab reads or saves) with three "Handler timeout" lines
  // and a 500; the same request not left answers 200.
  stage.match {
    selector = `{service_name="grafana"} |= "\"level\":\"error\"" |~ "context canceled\"|Handler timeout|Post-timeout activity|\"path\":\"/apis/userstorage[.]grafana[.]app/[^\"]*\",.*\"status\":500,"`

    stage.template {
      source   = "level"
      template = "info"
    }
  }

  // blackbox logs a failed probe as an error: a fault of the site it probes, which probe_success records for the
  // site-down and flight-tracker-down alerts, and which has no level setting (--log.prober adds lines, not hides them).
  stage.match {
    selector = `{service_name="blackbox"} |= "\"module\":" |= "\"level\":\"ERROR\""`

    stage.template {
      source   = "level"
      template = "warn"
    }
  }

  // Every line is stored as JSON: one a program wrote as text becomes {"level", "msg"}, its level read above.
  stage.match {
    selector = "{container_name=~\".+\"} !~ \"^[{]\""

    stage.template {
      source   = "json_line"
      template = "{{ if .level }}{{ toJson (dict \"level\" .level \"msg\" .Entry) }}{{ else }}{{ toJson (dict \"msg\" .Entry) }}{{ end }}"
    }
    stage.output {
      source = "json_line"
    }
  }

  // The label and the metadata below reach the log store as fields of each line.
  stage.labels {
    values = {
      level = "level",
    }
  }

  stage.structured_metadata {
    values = {
      logger   = "logger",
      event    = "event",
      stage    = "stage",
      trace_id = "trace_id",
      span_id  = "span_id",
    }
  }
}

// Each service's error and fatal lines, counted for the rule that posts them (prometheus/rules.yml, errors-logged),
// as `homelab_error_lines_total` on Alloy's own metrics. Of a line's labels only its service and level are kept (the
// scrape adds Alloy's own): a unit or container name would start a series per CI VM or recreate. A series is kept
// while Alloy runs, and starts at its first line. Programs log to their output, so the OTLP logs path
// (loki.process "programs") carries no line to count.
loki.process "error_lines" {
  forward_to = []

  stage.label_keep {
    values = ["service_name", "level"]
  }

  stage.match {
    selector = `{level=~"error|fatal"}`

    stage.metrics {
      metric.counter {
        name              = "error_lines_total"
        prefix            = "homelab_"
        description       = "Lines logged at error or fatal, by service."
        match_all         = true
        action            = "inc"
        max_idle_duration = "8760h"
      }
    }
  }
}

// ================================
// Host Logs (systemd journal)
// ================================

// The host's own services (Docker, Tailscale, the CI supervisor, the timers), as the container `journal` with each
// line's unit and service, so the log store files them like a container's.
loki.relabel "journal" {
  forward_to = []

  // sudo logs each command it runs, and tailscaled each Tailscale SSH session's command, over as many lines as it has:
  // secrets in their arguments included. Nothing reads them from the store; journalctl on the Beelink still has them.
  rule {
    source_labels = ["__journal__comm"]
    regex         = "sudo|tailscaled"
    action        = "drop"
  }
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  // Each line's `service_name`, as a container's (discovery.relabel "docker_logs"): its service unit without
  // `.service`, Colin's own (deploy-main) over the user manager's; else the program's name, as the kernel's, systemd's
  // own (init.scope) and a template unit's (user@1000) lines have no other. Each rule sets it only when its field is
  // there.
  rule {
    target_label = "service_name"
    replacement  = "unknown_service"
  }
  rule {
    source_labels = ["__journal_syslog_identifier"]
    regex         = "(.+)"
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "([^@]+)\\.service"
    target_label  = "service_name"
  }
  // One unit per CI VM, named for its runner (ci-runner/supervisor/vms.py).
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "(homelab-ci-vm)-.+\\.service"
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__journal__systemd_user_unit"]
    regex         = "([^@]+)\\.service"
    target_label  = "service_name"
  }
  // The containers' level words (loki.process "docker").
  rule {
    source_labels = ["__journal_priority_keyword"]
    regex         = "emerg|alert|crit"
    target_label  = "level"
    replacement   = "fatal"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    regex         = "err"
    target_label  = "level"
    replacement   = "error"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    regex         = "warning"
    target_label  = "level"
    replacement   = "warn"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    regex         = "notice|info"
    target_label  = "level"
    replacement   = "info"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    regex         = "debug"
    target_label  = "level"
    replacement   = "debug"
  }
}

loki.source.journal "host" {
  path          = "/var/log/journal"
  relabel_rules = loki.relabel.journal.rules
  labels        = {
    container_name = "journal",
    instance       = constants.hostname,
  }
  forward_to = [loki.secretfilter.journal.receiver]
}

// Before the lines become JSON, whose escaped quotes the filter's password rules do not match. Then the containers'
// pipeline: a host script's JSON line keeps its own level, any other line is wrapped with the journal's.
loki.secretfilter "journal" {
  redact_percent = 100
  forward_to     = [loki.process.docker.receiver]
}

// ================================
// Logs Destination (the log store)
// ================================

// The journal's and programs' lines pass here, the containers' through loki.secretfilter "docker": secrets in them, by
// gitleaks' default rules, become REDACTED, since the agents' login reads the store.
loki.secretfilter "logs" {
  // All of it: by default it keeps a fifth of each secret.
  redact_percent = 100
  forward_to     = [otelcol.receiver.loki.logs.receiver]
}

// Over OTLP, to VictoriaLogs.
otelcol.receiver.loki "logs" {
  output {
    logs = [otelcol.processor.batch.logs.input]
  }
}

// One request per line filled the exporter's queue.
otelcol.processor.batch "logs" {
  output {
    logs = [otelcol.exporter.otlphttp.logs.input]
  }
}

otelcol.exporter.otlphttp "logs" {
  client {
    endpoint = "http://logs:9428/insert/opentelemetry"
    // Alloy's OTLP sends each line's labels as attributes of the line, and VictoriaLogs makes streams only of
    // resource attributes unless told.
    headers = {
      "VL-Stream-Fields" = "container_name",
    }
  }
  // A store down for an outage or a deploy loses nothing while Alloy runs: it keeps trying for an hour, holding up to
  // 10,000 batches.
  retry_on_failure {
    max_elapsed_time = "1h"
  }
  sending_queue {
    queue_size = 10000
  }
}

// Its own metrics, for the rules that notice it down or no longer taking data (prometheus/rules.yml, group stores).
prometheus.scrape "logs" {
  targets         = [{ __address__ = "logs:9428" }]
  job_name        = "logs"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// ================================
// OTLP from programs (traces and their logs)
// ================================

// Programs send traces, logs and metrics here, by OTLP over HTTP on observability-otlp, and the host's on host-otlp
// (compose.yaml). Traces go on to VictoriaTraces, logs to the log store with their trace and span IDs, which Grafana
// links to the trace.
otelcol.receiver.otlp "programs" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces  = [otelcol.processor.transform.peers.input]
    logs    = [otelcol.exporter.loki.programs.input]
    metrics = [otelcol.exporter.prometheus.programs.input]
  }
}

// Programs' logs pass the secret filter too, which takes Loki's form: each line becomes JSON with its body, attributes and
// IDs, and its trace and span IDs come back out as fields, for Grafana's link to the trace.
otelcol.exporter.loki "programs" {
  forward_to = [loki.process.programs.receiver]
}

loki.process "programs" {
  forward_to = [loki.secretfilter.logs.receiver]

  stage.json {
    expressions = {
      trace_id = "traceid",
      span_id  = "spanid",
    }
  }

  stage.structured_metadata {
    values = {
      trace_id = "trace_id",
      span_id  = "span_id",
    }
  }
}

// Programs' metrics, OBI's request rate, errors and duration among them, go to Prometheus with the rest.
otelcol.exporter.prometheus "programs" {
  forward_to = [prometheus.remote_write.default.receiver]
}

// Who each call reached, as `peer.service`: the Compose service at the address it connected to, from Docker's API.
// OBI's `server.address` is the Host header the caller sent, which a proxy passes on (Caddy sends Prometheus the
// gateway's own), or else an IP; and the stores answer with no span to name them (obi/obi.yaml). A container is
// reached at its address on any of its networks, or at the host address and port it publishes; a call that never
// connected has no peer address, only the one it was sent to. The statements follow the containers as they start and
// stop. Docker's API cannot say which ports a container on the host's network serves, so its spans are marked, for
// the Traces page to read those from its server spans.
discovery.docker "peers" {
  host = "tcp://docker-socket-proxy:2375"
  // A target for each network a container is on, not only its first: a caller may reach it on any.
  match_first_network = false
}

discovery.relabel "peers" {
  targets = discovery.docker.peers.targets

  rule {
    source_labels = ["__meta_docker_network_ip", "__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(.+);(.+)"
    target_label  = "by_address"
    replacement   = "set(attributes[\"peer.service\"], \"$2\") where kind == SPAN_KIND_CLIENT and (attributes[\"network.peer.address\"] == \"$1\" or (attributes[\"network.peer.address\"] == nil and attributes[\"server.address\"] == \"$1\"))"
  }
  rule {
    source_labels = ["__meta_docker_port_public_ip", "__meta_docker_port_public", "__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(.+);(.+);(.+)"
    target_label  = "by_port"
    replacement   = "set(attributes[\"peer.service\"], \"$3\") where kind == SPAN_KIND_CLIENT and (attributes[\"network.peer.address\"] == \"$1\" or (attributes[\"network.peer.address\"] == nil and attributes[\"server.address\"] == \"$1\")) and attributes[\"server.port\"] == $2"
  }
  rule {
    source_labels = ["__meta_docker_container_network_mode", "__meta_docker_container_name"]
    regex         = "host;/(.+)"
    target_label  = "on_host"
    replacement   = "set(resource.attributes[\"container.network.mode\"], \"host\") where resource.attributes[\"container.name\"] == \"$1\""
  }
  // Only the statements, so no other Docker label's text reaches the step below.
  rule {
    action = "labelkeep"
    regex  = "by_address|by_port|on_host"
  }
}

// Alloy has no map over a list, and its generally available functions read a target only as text: printed, the
// targets are JSON but for `=` between key and value and a space between targets. alloy_test.py runs this on
// an Alloy of the image's version. A statement that fails is skipped, so a span is never dropped.
otelcol.processor.transform "peers" {
  error_mode = "ignore"

  trace_statements {
    context    = "span"
    statements = array.concat(
      json_path(string.replace(string.replace(string.format("%v", discovery.relabel.peers.output), "\"=\"", "\":\""), "} {", "}, {"), "[*].by_address"),
      json_path(string.replace(string.replace(string.format("%v", discovery.relabel.peers.output), "\"=\"", "\":\""), "} {", "}, {"), "[*].by_port"),
      json_path(string.replace(string.replace(string.format("%v", discovery.relabel.peers.output), "\"=\"", "\":\""), "} {", "}, {"), "[*].on_host"),
    )
  }

  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "traces" {
  output {
    traces = [otelcol.exporter.otlphttp.traces.input]
  }
}

otelcol.exporter.otlphttp "traces" {
  client {
    endpoint = "http://traces:10428/insert/opentelemetry"
  }
  // As the log store's.
  retry_on_failure {
    max_elapsed_time = "1h"
  }
  sending_queue {
    queue_size = 10000
  }
}

prometheus.scrape "traces" {
  targets         = [{ __address__ = "traces:10428" }]
  job_name        = "traces"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// ================================
// The tunnel (cloudflared, stacks/tunnel)
// ================================

// Its own metrics: requests through the tunnel and its connections to Cloudflare.
prometheus.scrape "cloudflared" {
  targets         = [{ __address__ = "tunnel-cloudflared-1:2000" }]
  job_name        = "cloudflared"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

