// ================================
// Host Metrics (node_exporter)
// ================================

prometheus.exporter.unix "host" {
  procfs_path = "/rootproc"
  sysfs_path  = "/sys"
  rootfs_path = "/rootfs"

  // *.prom files written by other stacks, e.g. the backup success timestamp.
  textfile {
    directory = "/rootfs/var/lib/homelab-metrics"
  }
}

prometheus.scrape "host" {
  targets    = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.remote_write.default.receiver]

  scrape_interval = "15s"
}

// ================================
// Container Metrics (cAdvisor)
// ================================

prometheus.exporter.cadvisor "docker" {
  docker_only = true
  docker_host = "tcp://docker-socket-proxy:2375"
}

discovery.relabel "cadvisor" {
  targets = prometheus.exporter.cadvisor.docker.targets

  rule {
    target_label = "job"
    replacement  = "docker"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

prometheus.scrape "cadvisor" {
  targets    = discovery.relabel.cadvisor.output
  forward_to = [prometheus.remote_write.default.receiver]

  scrape_interval = "15s"
}

// ================================
// CI VM Metrics (cAdvisor)
// ================================

// The Firecracker CI VMs are processes, not containers: each runs in its slot's
// cgroup, /firecracker/ci-slotN, which exists only while that slot has a VM.
// No docker_host: with no Docker socket in this container it skips containers,
// which the exporter above already collects.
prometheus.exporter.cadvisor "ci_vms" {
  docker_only                 = false
  enabled_metrics             = ["cpu", "memory"]
  raw_cgroup_prefix_allowlist = ["/firecracker/"]
}

discovery.relabel "ci_vms" {
  targets = prometheus.exporter.cadvisor.ci_vms.targets

  rule {
    target_label = "job"
    replacement  = "ci-vms"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

prometheus.scrape "ci_vms" {
  targets    = discovery.relabel.ci_vms.output
  forward_to = [prometheus.relabel.ci_vms.receiver]

  scrape_interval = "15s"
}

// Only the VMs' own cgroups; this exporter also reports the whole machine,
// which the host scrape already covers.
prometheus.relabel "ci_vms" {
  forward_to = [prometheus.remote_write.default.receiver]

  rule {
    source_labels = ["id"]
    regex         = "/firecracker/.+"
    action        = "keep"
  }
}

// ================================
// Metrics Destination (Prometheus)
// ================================

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
  // OpenObserve takes over at the cutover (docs/adr/0001-openobserve.md).
  endpoint {
    url = "http://openobserve:5080/api/default/prometheus/api/v1/write"
    basic_auth {
      username = "root@homelab.internal"
      password = sys.env("OPENOBSERVE_PASSWORD")
    }
  }
}

// ================================
// Container Log Discovery
// ================================

discovery.docker "containers" {
  host = "tcp://docker-socket-proxy:2375"
}

discovery.relabel "docker_logs" {
  targets = []

  // The socket proxy logs every Alloy API request; keep it out of Loki.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/.*docker-socket-proxy.*"
    action        = "drop"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }
  rule {
    source_labels = ["__meta_docker_container_image_name"]
    target_label  = "image"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

// ================================
// Container Logs (Docker)
// ================================

loki.source.docker "containers" {
  host          = "tcp://docker-socket-proxy:2375"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.docker_logs.rules
  forward_to    = [loki.process.docker.receiver]
}

loki.process "docker" {
  forward_to = [loki.write.default.receiver, otelcol.receiver.loki.openobserve.receiver]

  // Parse JSON log lines (silently passes through non-JSON lines)
  stage.json {
    expressions = {
      level  = "level",
      logger = "logger",
    }
  }

  // Low-cardinality fields as Loki labels (fast stream filtering)
  stage.labels {
    values = {
      level = "level",
    }
  }

  // High-cardinality fields as structured metadata (searchable, no stream explosion)
  stage.structured_metadata {
    values = {
      logger = "logger",
      event  = "event",
      stage  = "stage",
    }
  }

  // Drop noisy observability stack logs to avoid feedback loops
  stage.drop {
    source     = "container_name"
    expression = "(alloy|loki)"
  }
}

// ================================
// Logs Destination (Loki)
// ================================

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// The same logs to OpenObserve, over OTLP.
otelcol.receiver.loki "openobserve" {
  output {
    logs = [otelcol.processor.batch.openobserve.input]
  }
}

// One request per line filled the exporter's queue.
otelcol.processor.batch "openobserve" {
  output {
    logs = [otelcol.exporter.otlphttp.openobserve.input]
  }
}

otelcol.auth.basic "openobserve" {
  username = "root@homelab.internal"
  password = sys.env("OPENOBSERVE_PASSWORD")
}

otelcol.exporter.otlphttp "openobserve" {
  client {
    endpoint = "http://openobserve:5080/api/default"
    auth     = otelcol.auth.basic.openobserve.handler
    headers  = {
      "stream-name" = "containers",
    }
  }
}

// ================================
// Alertmanager
// ================================

// Whether it is up, and its notifications_failed_total: posts that did not reach Discord.
prometheus.scrape "alertmanager" {
  targets = [{
    __address__ = "alertmanager:9093",
  }]
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "60s"
  job_name        = "alertmanager"
}

// ================================
// Flight Tracker (end-to-end probe)
// ================================

// Probes the public API through Cloudflare and the tunnel. Succeeds only when
// the backend is serving live upstream aircraft data, not stale cache.
prometheus.exporter.blackbox "flight_tracker" {
  config = "{ modules: { aircraft_live: { prober: http, timeout: 15s, http: { preferred_ip_protocol: ip4, ip_protocol_fallback: false, valid_status_codes: [200], fail_if_body_not_matches_regexp: ['\"apiHealth\":\\s*\"live\"'] } } } }"

  target {
    name    = "flight-tracker"
    address = "https://api.colincheung.dev/aircraft"
    module  = "aircraft_live"
  }
}

prometheus.scrape "flight_tracker" {
  targets         = prometheus.exporter.blackbox.flight_tracker.targets
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "60s"
}

