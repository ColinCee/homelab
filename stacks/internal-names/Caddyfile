{
	admin off
	auto_https off
	default_bind 100.100.146.119
}

# Only other tailnet devices; the tailnet policy decides which ones reach port 80.
(tailnet_only) {
	@refused expression !remote_ip('100.64.0.0/10') || remote_ip('100.100.146.119')
	respond @refused 403
}

http://control.internal {
	import tailnet_only
	reverse_proxy 100.100.146.119:8090
}

http://grafana.internal {
	import tailnet_only
	reverse_proxy 100.100.146.119:3001
}

# Home Assistant trusts proxies on 127.0.0.1 (its configuration.yaml, http: trusted_proxies).
http://home.internal {
	import tailnet_only
	reverse_proxy 127.0.0.1:8123
}
