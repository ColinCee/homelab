{
	admin off
	auto_https off
	default_bind 100.100.146.119
	metrics {
		per_host
	}
}

# Its metrics, on loopback for host-metrics (../observability/compose.yaml); with the admin API off, nothing else serves
# them.
http://127.0.0.1:2019 {
	bind 127.0.0.1
	metrics
}

# Other tailnet devices only, never Beelink itself (stacks/observability/probes.py checks the 403);
# the tailnet policy decides which devices reach port 80.
(tailnet_only) {
	@refused expression !remote_ip('100.64.0.0/10') || remote_ip('100.100.146.119')
	respond @refused 403
}

# A deploy restarts the service behind a name for a few seconds; a request waits through that instead of failing.
(through_restarts) {
	lb_try_duration 30s
}

http://grafana.internal {
	import tailnet_only
	reverse_proxy 100.100.146.119:5080 {
		import through_restarts
	}
}

# Home Assistant trusts proxies on loopback (http: trusted_proxies in its configuration.yaml on Beelink).
http://home.internal {
	import tailnet_only
	reverse_proxy 127.0.0.1:8123 {
		import through_restarts
	}
}
