{
	admin off
	auto_https off
	default_bind 100.100.146.119
}

# Other tailnet devices only, never Beelink itself (see compose.yaml, proxy); the tailnet
# policy decides which devices reach port 80.
(tailnet_only) {
	@refused expression !remote_ip('100.64.0.0/10') || remote_ip('100.100.146.119')
	respond @refused 403
}

http://kaizen.internal {
	import tailnet_only
	# The Control room takes actions only for its own host names, and for an Origin that matches
	# the Host; another site's Origin is left as it is, so it is still refused.
	reverse_proxy 100.100.146.119:8090 {
		header_up Host 100.100.146.119:8090
		header_up Origin ^http://kaizen\.internal$ http://100.100.146.119:8090
	}
}

http://grafana.internal {
	import tailnet_only
	reverse_proxy 100.100.146.119:3001
}

# Home Assistant trusts proxies on loopback (http: trusted_proxies in its configuration.yaml on Beelink).
http://home.internal {
	import tailnet_only
	reverse_proxy 127.0.0.1:8123
}
