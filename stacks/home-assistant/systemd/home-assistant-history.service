[Unit]
Description=Copy Home Assistant's history database consistently, for the nightly backup
Documentation=https://github.com/ColinCee/homelab/blob/main/docs/architecture.md#backups

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I %h/code/homelab/stacks/home-assistant/history.py
TimeoutStartSec=30min
