[Unit]
Description=Copy Home Assistant's history database consistently, for the nightly backup
Documentation=https://github.com/ColinCee/homelab/blob/main/docs/architecture.md#backups

[Service]
Type=oneshot
# SQLite's backup API gives a consistent copy of the live database; restic copies the result.
ExecStart=/usr/bin/docker exec homeassistant python3 -c "import os, sqlite3; s = sqlite3.connect('/config/home-assistant_v2.db'); d = sqlite3.connect('/config/history-snapshot.db.tmp'); s.backup(d); d.execute('pragma journal_mode=delete'); d.close(); os.replace('/config/history-snapshot.db.tmp', '/config/history-snapshot.db')"
