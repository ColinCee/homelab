#!/usr/bin/env bash
set -euo pipefail

# Check staged blobs, not decrypted working files. CI owns lint and tests.
while IFS= read -r -d '' file; do
  header=$(git show ":$file" | od -An -tx1 | awk 'NR == 1 { for (i = 1; i <= 10; i++) printf "%s", $i }')
  if [[ "$header" != "00474954435259505400" ]]; then
    printf 'Refusing plaintext commit of %s; configure git-crypt first.\n' "$file" >&2
    exit 1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- docs/private/)
