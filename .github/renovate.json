{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days"
  },
  "packageRules": [
    {
      "matchCategories": ["docker"],
      "pinDigests": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "groupName": "python",
      "matchDepNames": ["python"]
    },
    {
      "description": "Our own image: no wait needed. ghcr.io gives Renovate no release time, so the 3-day wait would hold it forever.",
      "matchPackageNames": ["ghcr.io/colincee/**"],
      "minimumReleaseAge": "0 days"
    },
    {
      "groupName": "uv",
      "matchPackageNames": ["uv", "ghcr.io/astral-sh/uv"]
    }
  ]
}
