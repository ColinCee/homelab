{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days"
  },
  "packageRules": [
    {
      "matchCategories": ["docker"],
      "pinDigests": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Home Assistant's major version is the year, so its January release is a routine update.",
      "matchPackageNames": ["homeassistant/home-assistant"],
      "matchUpdateTypes": ["major"],
      "automerge": true
    },
    {
      "groupName": "python",
      "matchDepNames": ["python"]
    },
    {
      "description": "Our own image: no wait needed. ghcr.io gives Renovate no release time, so the 3-day wait would hold it forever.",
      "matchPackageNames": ["ghcr.io/colincee/**"],
      "minimumReleaseAge": "0 days"
    },
    {
      "groupName": "uv",
      "matchPackageNames": ["uv", "ghcr.io/astral-sh/uv"]
    },
    {
      "description": "The release hash in versions.env must be updated by hand in the PR.",
      "matchFileNames": ["ci-runner/versions.env"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ci-runner/versions\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ]
}
