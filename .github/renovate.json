{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days"
  },
  "lockFileMaintenance": {
    "description": "pyproject.toml asks for ranges (ruff>=…), so only a weekly lock refresh moves uv.lock to the latest releases: without it ty sat 7 months behind.",
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "matchCategories": ["docker"],
      "pinDigests": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Home Assistant's major version is the year, so its January release is a routine update.",
      "matchPackageNames": ["homeassistant/home-assistant"],
      "matchUpdateTypes": ["major"],
      "automerge": true
    },
    {
      "groupName": "python",
      "matchDepNames": ["python"]
    },
    {
      "description": "Our own image: no wait, since ghcr.io gives Renovate no release time and the 3-day wait would hold it forever. Not auto-merged: the flight tracker's collaborators can publish to it, so a new image waits for Colin.",
      "matchPackageNames": ["ghcr.io/colincee/**"],
      "minimumReleaseAge": "0 days",
      "automerge": false
    },
    {
      "description": "Lock file refreshes, pins and digests carry no release time either, so the 3-day wait would hold them forever.",
      "matchUpdateTypes": ["lockFileMaintenance", "pin", "pinDigest", "digest"],
      "minimumReleaseAge": "0 days"
    },
    {
      "groupName": "uv",
      "matchPackageNames": ["uv", "ghcr.io/astral-sh/uv"]
    },
    {
      "description": "The tests run the stack's Prometheus and Alloy from mise.toml, at its images' versions.",
      "groupName": "prometheus",
      "matchPackageNames": ["prom/prometheus", "prometheus/prometheus"]
    },
    {
      "groupName": "alloy",
      "matchPackageNames": ["grafana/alloy"]
    },
    {
      "groupName": "caddy",
      "matchPackageNames": ["caddy", "caddyserver/caddy"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ci-runner/versions\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "description": "A GitHub release asset's hash moves with its version. Only this datasource's digest is a file hash; for the others it is a commit.",
      "customType": "regex",
      "managerFilePatterns": ["/^ci-runner/versions\\.env$/"],
      "datasourceTemplate": "github-release-attachments",
      "matchStrings": [
        "# renovate-hash: depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)\\n[A-Z_]+_SHA256=(?<currentDigest>[0-9a-f]{64})"
      ]
    }
  ]
}
