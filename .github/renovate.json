{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "docker": {
    "pinDigests": true
  },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days"
  },
  "packageRules": [
    {
      "groupName": "python",
      "matchDepNames": ["python"]
    },
    {
      "groupName": "uv",
      "matchPackageNames": ["uv", "ghcr.io/astral-sh/uv"]
    }
  ]
}
